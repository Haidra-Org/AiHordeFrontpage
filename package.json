{
  "name": "ai-horde-website",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.22.2"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "serve:ssr:AiHordeWebsite": "node dist/ai-horde-website/server/server.mjs",
    "deploy": "ng build && npx wrangler deploy",
    "lint": "ng lint",
    "lint:prettier-sync": "node scripts/check-prettier-config-sync.mjs",
    "lint:css": "node scripts/lint-css-duplicates.mjs",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\"",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:spec": "tsc --noEmit -p tsconfig.spec.json",
    "typecheck": "npm run typecheck:app && npm run typecheck:spec",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/build": "^22.2.6",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/ssr": "^22.2.6",
    "@jsverse/transloco": "8.4.0",
    "@tailwindcss/postcss": "^4.3.4",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "konva": "^10.9.1",
    "marked": "^17.0.6",
    "postcss": "^8.5.32",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.4",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.6",
    "@analogjs/vitest-angular": "^2.9.6",
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.6.28",
    "angular-cli-ghpages": "^3.1.2",
    "angular-eslint": "^22.6.0",
    "eslint-plugin-rxjs-x": "^1.0.6",
    "fake-indexeddb": "^6.2.7",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.html": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
